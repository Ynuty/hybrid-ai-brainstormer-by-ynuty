# OpenRouter (рекомендуется, если модели в agents_config с префиксом openrouter/)
OPENROUTER_API_KEY=

# Опционально: другие провайдеры LiteLLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Streamlit → бэкенд
BACKEND_URL=http://127.0.0.1:8000

# CORS для браузерного фронтенда, через запятую
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Путь к YAML (по умолчанию agents_config.yaml в корне)
AGENTS_CONFIG_PATH=agents_config.yaml

# Таймаут одного LLM-вызова (сек)
MODEL_TIMEOUT_S=120

# Повторы при временных ошибках модели
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BACKOFF_S=1.5

# OCR для сканированных PDF (опционально, если tesseract не в PATH)
TESSERACT_CMD=
PDF_OCR_DPI=200

# Если agents_config.yaml нет — используются эти модели (LiteLLM-строка)
BRAINSTORM_MODEL=openrouter/openai/gpt-5.1
SYNTHESIS_MODEL=openrouter/openai/gpt-5.1

# OpenRouter is required when models use the openrouter/ prefix.
OPENROUTER_API_KEY=

# Optional provider keys for other LiteLLM model prefixes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional API protection (empty = disabled for local dev).
API_SECRET=

# Streamlit frontend -> FastAPI backend.
BACKEND_URL=http://127.0.0.1:8000

# Browser CORS origins, comma-separated.
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Agent role/model configuration (models live here, not in env).
AGENTS_CONFIG_PATH=agents_config.yaml

# LLM call timeout and retry settings.
MODEL_TIMEOUT_S=120
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BACKOFF_S=1.5
LLM_MAX_CONCURRENT=3

# Request size limits.
MAX_TOPIC_CHARS=2000
MAX_CONTEXT_CHARS=80000
MAX_COMMENTS_CHARS=10000
MAX_UPLOAD_MB=25
MAX_AUDIO_UPLOAD_MB=50

# NotebookLM-style context sources.
ENABLE_URL_IMPORT=true
ENABLE_YOUTUBE_IMPORT=true
ENABLE_AUDIO_TRANSCRIBE=true
URL_FETCH_TIMEOUT_S=15
URL_FETCH_MAX_BYTES=5000000
# Comma-separated host allowlist (empty = any public host, SSRF still blocked).
URL_FETCH_ALLOWED_HOSTS=
YOUTUBE_USE_YTDLP=false
AUDIO_TRANSCRIBE_MODE=cloud
WHISPER_MODEL=whisper-1
WHISPER_LOCAL_MODEL=base

# Background jobs.
JOB_TTL_HOURS=24
DEBATE_JOB_MAX_SECONDS=1800

# OCR for scanned PDFs on backend.
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"
PDF_OCR_DPI=200

# Fallback models only if agents_config.yaml is missing.
BRAINSTORM_MODEL=openrouter/openai/gpt-5.1
SYNTHESIS_MODEL=openrouter/openai/gpt-5.1

PORT=8000
